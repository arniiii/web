{
  "name": "semester-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "python3 scripts/setup.py",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api": "backend/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
