[Unit]
Description=Renew the Semester HTTPS certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/semester/certbot/bin/certbot renew --quiet --no-random-sleep-on-renew --cert-name semester --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
